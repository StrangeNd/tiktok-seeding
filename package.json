{
  "name": "tiktok-seeding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TikTok seeding platform — multi-machine GPM antidetect orchestration.",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:dashboard": "pnpm --filter @app/dashboard run build",
    "build:server": "pnpm --filter @app/shared --filter @app/gpm-client --filter @app/tiktok-actions --filter @app/master --filter @app/worker run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/setup.ps1",
    "db:generate": "pnpm --filter @app/master run db:generate",
    "db:migrate": "pnpm --filter @app/master run db:migrate",
    "db:studio": "pnpm --filter @app/master run db:studio",
    "master": "pnpm --filter @app/master run dev",
    "worker": "pnpm --filter @app/worker run dev",
    "dashboard": "pnpm --filter @app/dashboard run dev",
    "dashboard:build": "pnpm --filter @app/dashboard run build",
    "package:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/package-local.ps1",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/release-check.ps1",
    "clean:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/clean-runtime.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/doctor.ps1",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "start:all:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "start:all:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "start:all:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start.ps1 -Dev",
    "stop:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/stop.ps1",
    "restart:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/restart.ps1",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/status.ps1",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/logs.ps1",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/backup.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/restore.ps1",
    "update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/update.ps1",
    "reset:profiles": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/reset-profiles.ps1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
