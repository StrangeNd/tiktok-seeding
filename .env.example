# Copy file này thành .env và điền giá trị thật.
NODE_ENV=development
LOG_LEVEL=debug

# ─── Master (Fastify API) ───
MASTER_PORT=7000
MASTER_API_KEY=dev-key-change-me

# ─── Database (Postgres native) ───
# Sau khi cài Postgres, tạo DB: createdb -U postgres seeding
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/seeding

# ─── Queue (Redis / Memurai native) ───
REDIS_URL=redis://127.0.0.1:6379

# ─── GPM Login Global API (Phase 0 verified) ───
# Set GPM_MODE=mock when real GPM is unreachable (e.g. Devin Cloud, CI).
GPM_MODE=live
GPM_ENDPOINT=http://127.0.0.1:9495
GPM_API_PREFIX=/api/v1
GPM_API_KEY=

# ─── Worker ───
WORKER_NAME=worker-local
CONCURRENCY=10

# ─── Dashboard ───
# Vite dev server port. The dashboard talks to MASTER_PORT via REST + the
# master API key the operator pastes on the login screen.
DASHBOARD_PORT=5173

# ─── Secrets / sensitive storage ───
# AES-256-GCM key (>=16 chars; use 32+ in production). Used to encrypt
# account/proxy secret blobs at rest. Rotating this invalidates existing blobs.
CREDENTIALS_ENCRYPTION_KEY=dev-credentials-key-change-me-please-32+ch

# Neutral connectivity probe target for proxy validation. Must be a generic
# endpoint — do NOT point this at TikTok or any platform-specific URL.
PROXY_TEST_URL=https://api.ipify.org?format=text
PROXY_TEST_TIMEOUT_MS=8000

# ─── Mail code retrieval (owned-account inboxes only) ───
# Default `custom` is a safe local-dev default and returns provider_unsupported.
# Set to `microsoft` to use Microsoft Graph OAuth2 refresh-token mailbox access.
# `gmail` is reserved for a future adapter and currently returns provider_unsupported.
MAIL_PROVIDER=custom
MAIL_CODE_LOOKBACK_MINUTES=15
MAIL_CODE_MAX_RESULTS=10
# Optional comma-separated filters. Leave empty to search recent inbox messages.
MAIL_CODE_ALLOWED_SENDERS=
MAIL_CODE_SUBJECT_HINTS=code,verification,verify,security
MAIL_CODE_REQUEST_COOLDOWN_SECONDS=30
